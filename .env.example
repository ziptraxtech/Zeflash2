# Backend Environment Variables
# IMPORTANT: Copy this to .env on your EC2 instance and fill in with REAL values
# DO NOT commit .env to git - it will be git-ignored

# Node environment
NODE_ENV=production
PORT=3000

# ML Backend Service - Points to ECS ALB endpoint
# Updated: Now uses ALB instead of direct EC2 instance
ML_BACKEND_URL=http://zeflash-ml-alb-2095066601.us-east-1.elb.amazonaws.com

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS S3 - For ML inference reports
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET=your_bucket_name

# Clerk Authentication - For user token verification
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Razorpay - Payment processing
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Frontend URL
VITE_API_BASE=https://zeflash.vercel.app
