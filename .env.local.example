# ⚠️ SECURE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your actual values
# .env.local should NEVER be committed to Git (.gitignore includes it)

# ════════════════════════════════════════════════════════════════
# AWS CONFIGURATION - Get from IAM → Users → Security credentials
# ════════════════════════════════════════════════════════════════
AWS_ACCESS_KEY_ID="your-new-access-key-id"
AWS_SECRET_ACCESS_KEY="your-new-secret-access-key"
AWS_DEFAULT_REGION="us-east-1"
AWS_REGION="us-east-1"
AWS_ACCOUNT_ID="070872471952"

# ════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION - PostgreSQL via Neon
# ════════════════════════════════════════════════════════════════
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# ════════════════════════════════════════════════════════════════
# AUTHENTICATION & PAYMENT SECRETS
# ════════════════════════════════════════════════════════════════
# Clerk (Auth)
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"

# Razorpay (Payment)
VITE_RAZORPAY_KEY_ID="rzp_live_your-key-id"
VITE_RAZORPAY_KEY_SECRET="your-key-secret"

# Vercel OIDC Token
VERCEL_OIDC_TOKEN="your-vercel-token"

# ════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT URLS
# ════════════════════════════════════════════════════════════════
BACKEND_API_URL="http://localhost:3001"
VITE_API_URL="http://localhost:3001"
ML_BACKEND_URL="http://127.0.0.1:8000"
VITE_ML_API_URL="/api/ml-proxy"

# Frontend Configuration
VITE_AI_REPORT_URL="https://your-lambda-url.lambda-url.us-east-1.on.aws/"
VITE_DEBUG=true
VITE_PORT=5173

# ════════════════════════════════════════════════════════════════
# AWS STORAGE & DATABASE SERVICES
# ════════════════════════════════════════════════════════════════
S3_BUCKET="battery-ml-results-070872471952"
S3_PREFIX="battery-reports/"
DYNAMODB_TABLE_NAME="zeflash-users"

# ════════════════════════════════════════════════════════════════
# EXTERNAL APIs
# ════════════════════════════════════════════════════════════════
TOKEN_ENDPOINT="https://cms.charjkaro.in/admin/api/v1/zipbolt/token"
API_BASE_URL="https://cms.charjkaro.in/commands/secure/api/v1/get/charger/time_lapsed"
Authorization="Bearer your-auth-token"
