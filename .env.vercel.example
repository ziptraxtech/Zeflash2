# Vercel Production Environment Variables
# Update these on your Vercel dashboard

# Backend API endpoint (EC2 IP address)
# Replace 3.90.162.23 with your actual EC2 public IP or domain
VITE_API_BASE=http://3.90.162.23:3000

# Or if using a domain pointing to EC2:
# VITE_API_BASE=https://api.yourdomain.com

# Clerk Authentication - Keep your existing keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_production_key_here

# ML API endpoint
VITE_ML_API_URL=/api/ml-proxy

# Razorpay Payment Gateway - Keep your existing keys
VITE_RAZORPAY_KEY_ID=rzp_live_your_production_key_here

# AI Report Lambda
VITE_AI_REPORT_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws/

# Optional: For local development  
# Uncomment and update dev values
# VITE_API_BASE=http://localhost:3001
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_dev_key_here
# VITE_RAZORPAY_KEY_ID=rzp_test_your_dev_key_here
