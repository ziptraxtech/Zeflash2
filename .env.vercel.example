# Vercel Production Environment Variables
# Update these on your Vercel dashboard

# Backend API endpoint - Used by Vercel proxy (/api/backend/*)
# The proxy forwads requests to the EC2 backend on port 3001
BACKEND_URL=http://3.90.162.23:3001

# Frontend uses /api/backend proxy by default in production
# (VITE_API_BASE is optional - if not set, defaults to /api/backend)
VITE_API_BASE=/api/backend

# ML API endpoint (ALB - Application Load Balancer)
# Points to ECS ml-cluster with ALB routing
ML_BACKEND_URL=http://zeflash-ml-alb-2095066601.us-east-1.elb.amazonaws.com
VITE_ML_API_URL=http://zeflash-ml-alb-2095066601.us-east-1.elb.amazonaws.com

# Clerk Authentication - Keep your existing keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_production_key_here

# Razorpay Payment Gateway - Keep your existing keys
VITE_RAZORPAY_KEY_ID=rzp_live_your_production_key_here

# AI Report Lambda
VITE_AI_REPORT_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws/

# S3 Bucket for report images
S3_BUCKET=battery-ml-results-test

# ========================================
# Setup Instructions for Vercel Dashboard
# ========================================
# 1. Go to your Vercel project settings
# 2. Navigate to Environment Variables
# 3. Add all variables above with your actual values
# 4. Important: Set BACKEND_URL to your EC2 backend IP/domain on port 3001
# 5. VITE_API_BASE can stay as /api/backend (uses Vercel proxy)
# 6. Redeploy after updating environment variables
# ========================================

# ========================================
# LOCAL DEVELOPMENT (development environment)
# ========================================
# Backend API (local backend)
# VITE_API_BASE=http://localhost:3000

# ML API (local dev server)
# VITE_ML_API_URL=http://localhost:8000
# ML_BACKEND_URL=http://localhost:8000

# Clerk Dev Keys
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_dev_key_here

# Razorpay Test Keys
# VITE_RAZORPAY_KEY_ID=rzp_test_your_dev_key_here
