# Backend Environment Variables - Updated for ECS ML Service

# ============ Server Configuration ============
PORT=3001
NODE_ENV=production

# ============ Database ============
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host/your_db_name

# ============ Authentication ============
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# ============ Payment ============
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ============ Partner integrations ============
# Shared secret EVChamp's backend presents (as a Bearer token) when calling
# POST /partner/credits/grant to credit a user here after an EVChamp
# purchase. Must match the ZEFLASH_PARTNER_API_KEY EVChamp is configured
# with — see EVChamp's api/index.js PARTNER_GRANT_ENDPOINTS.
EVCHAMP_PARTNER_API_KEY=your_shared_partner_api_key

# ============ ML Service - Now on ECS ============
# Option 1: Use Network Load Balancer DNS (recommended)
ML_BACKEND_URL=http://battery-ml-nlb-xxxxx.elb.us-east-1.amazonaws.com:8000

# Option 2: Use ECS service discovery (if using service discovery)
# ML_BACKEND_URL=http://battery-ml-api-service.default.svc.cluster.local:8000

# Option 3: Use ECS task IP directly (less reliable, will change on redeploy)
# ML_BACKEND_URL=http://10.0.x.x:8000

# ============ CORS ============
CORS_ORIGIN=https://zeflash.app

# ============ AWS Credentials (if needed for S3, DynamoDB, etc) ============
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ============ Credits/Serverless Function ============
CREDITS_LAMBDA_URL=your_lambda_or_serverless_function_url
