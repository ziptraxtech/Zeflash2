# Environment Variables for ML Service on ECS

# ============ Original ML Config ============
TOKEN_ENDPOINT=https://cms.charjkaro.in/admin/api/v1/zipbolt/token
API_BASE_URL=https://cms.charjkaro.in/commands/secure/api/v1/get/charger/time_lapsed
PYTHONUNBUFFERED=1
PORT=8000

# ============ Backend Communication ============
# Update this to point to your EC2 backend or ALB
# Option 1: Direct EC2 IP (if same VPC)
# BACKEND_API_URL=http://172.31.x.x:3001

# Option 2: EC2 Public IP with security group rules
# BACKEND_API_URL=http://3.90.162.23:3001

# Option 3: Backend ALB (recommended)
# BACKEND_API_URL=http://backend-alb-xxxxx.elb.us-east-1.amazonaws.com:3001

# Use this for now (will be set in ECS task definition)
BACKEND_API_URL=http://EC2_PRIVATE_IP_OR_ALB:3001

# ============ AWS Configuration (if needed) ============
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

# ============ Logging ============
# LOG_LEVEL=INFO
